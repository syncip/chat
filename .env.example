# Kopieren nach .env und anpassen.
CHAT_DOMAIN=chat.example.org
CHAT_ADMIN_KEY=bitte-ersetzen-mit-openssl-rand-hex-24

# Optional
# CHAT_REGISTRATION=invite
# CHAT_FEDERATION=open
# CHAT_USER_QUOTA=10737418240
# CHAT_MAX_FILE_SIZE=104857600
# CHAT_BIND=127.0.0.1:8080
# CHAT_TRUST_PROXY_HEADER=        # nur hinter Proxy/Tunnel, z. B. X-Forwarded-For

# Nur mit optionalen Tunneln (deploy/README.md):
# CF_TUNNEL_TOKEN=
# PANGOLIN_ENDPOINT=https://pangolin.example.org
# NEWT_ID=
# NEWT_SECRET=
